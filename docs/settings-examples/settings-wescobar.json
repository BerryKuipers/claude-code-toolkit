{
  "$comment": "Example settings.json for Wescobar project - Full-stack TypeScript with strict architecture",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"git submodule update --init --recursive 2>/dev/null; test -f .claude-toolkit/scripts/sync-claude-toolkit.sh && bash .claude-toolkit/scripts/sync-claude-toolkit.sh\""
          },
          {
            "type": "command",
            "command": "bash -c \"test -f scripts/install-gh-cli.sh && bash scripts/install-gh-cli.sh\""
          },
          {
            "type": "command",
            "command": "bash -c \"test -f .claude/hooks/process-pending-memory.sh && bash .claude/hooks/process-pending-memory.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"test -f .claude/hooks/process-pending-memory.sh && bash .claude/hooks/process-pending-memory.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"test -f .claude/hooks/enforce-agent-routing.sh && bash .claude/hooks/enforce-agent-routing.sh '$CLAUDE_USER_PROMPT'\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"test -f .claude/hooks/validate-code-quality.sh && bash .claude/hooks/validate-code-quality.sh '$CLAUDE_TOOL_NAME' '$CLAUDE_TOOL_ARGS'\""
          }
        ]
      },
      {
        "matcher": "Bash|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"test -f .claude/hooks/pre-tool-use.sh && bash .claude/hooks/pre-tool-use.sh '$CLAUDE_TOOL_NAME' '$CLAUDE_TOOL_ARGS'\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"test -f .claude/hooks/post-tool-quality-gate.sh && bash .claude/hooks/post-tool-quality-gate.sh '$CLAUDE_TOOL_NAME' '$CLAUDE_TOOL_ARGS'\""
          }
        ]
      },
      {
        "matcher": "Task|SlashCommand",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"test -f .claude/hooks/post-tool-use.sh && bash .claude/hooks/post-tool-use.sh '$CLAUDE_TOOL_NAME' '$CLAUDE_TOOL_ARGS'\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"echo '$CLAUDE_TOOL_ARGS' | grep -q 'git commit' && test -f .claude/hooks/post-commit-memory.sh && bash .claude/hooks/post-commit-memory.sh\""
          }
        ]
      }
    ]
  }
}
