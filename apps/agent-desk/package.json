{
  "name": "agent-desk",
  "version": "0.2.0",
  "description": "One desktop workspace for your coding agents, sessions, models and skills.",
  "private": true,
  "type": "module",
  "author": "Berry Kuipers",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "tauri build --no-bundle",
    "build:renderer": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core && vitest run",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --locked --no-default-features",
    "test:desktop": "playwright test",
    "start": "tauri dev",
    "dist": "tauri build",
    "dist:linux": "tauri build --bundles deb,appimage",
    "dist:win": "tauri build --bundles nsis",
    "dist:mac": "tauri build --bundles dmg",
    "format": "prettier --write src tests scripts *.ts *.json && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test:resources": "node scripts/measure-resources.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9",
    "webdriverio": "^10.2.0"
  }
}
